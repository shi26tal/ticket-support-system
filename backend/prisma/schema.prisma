// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  AGENT
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  username String @unique
  email    String @unique
  password String

  role Role @default(CUSTOMER)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // relation
  tickets  Ticket[]        @relation("CustomerTickets")
  assigned Ticket[]        @relation("AssignedTickets")
  messages TicketMessage[]
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          Int            @id @default(autoincrement())
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // resolved and closed at
  resolvedAt DateTime? @db.Timestamptz
  closedAt   DateTime? @db.Timestamptz

  // relation
  // which user created the ticket
  customerId Int
  customer   User @relation("CustomerTickets", fields: [customerId], references: [id])

  // which agent is assigned to the ticket
  assignedToId Int?
  assignedTo   User? @relation("AssignedTickets", fields: [assignedToId], references: [id])

  // category ticket belong to
  categoryId Int
  category   TicketCategory @relation(fields: [categoryId], references: [id])

  messages TicketMessage[]

  // indexing to find the tickets based on customer, assigned agent, category and status and do queries faster
  @@index([customerId])
  @@index([assignedToId, status])
  @@index([categoryId])
  @@index([status])
}

model TicketMessage {
  id      Int    @id @default(autoincrement())
  message String

  ticketId  Int
  createdAt DateTime @default(now()) @db.Timestamptz

  // relation
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
  @@index([userId])
}

model TicketCategory {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  tickets Ticket[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}
